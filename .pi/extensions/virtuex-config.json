    "^\\s*(history)\\s*$",
    "^\\s*(alias|unalias)\\s*$",
    "^\\s*(set|export|unset|readonly|local)\\s+.*$",
    "^\\s*(source|\\.)\\s+.*$",
    "^\\s*(npm|npx|yarn|pnpm|pip|pip3|python|python3|node)\\s+(--version|-v|-V|help|-h|list|show|search|info)\\s+.*$",
    "^\\s*(git)\\s+(status|log|diff|show|branch|tag|describe|rev-parse|for-each-ref|ls-files|shortlog|for-each-ref|name-rev|verify-pack|check-ignore|check-attr|ls-tree|ls-files|diff-index|diff-tree|diff-files|show-branch|whatchanged|log|shortlog|for-each-ref|name-rev|verify-pack|check-ignore|check-attr|ls-tree|ls-files)\\s+.*$",
    "^\\s*(git)\\s+(add|commit|push|pull|fetch|merge|rebase|checkout|switch)\\s+.*$"
